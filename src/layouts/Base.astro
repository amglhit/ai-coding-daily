---
import "../styles/global.css";
import { sitePath } from "../lib/paths.mjs";

interface Props {
  title: string;
  description: string;
  surface?: "browse" | "reader";
}

const { title, description, surface = "browse" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      try {
        var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        document.documentElement.setAttribute("data-pointer", fine ? "fine" : "coarse");
      } catch (error) {
        document.documentElement.setAttribute("data-pointer", "fine");
      }
    </script>
  </head>
  <body data-surface={surface}>
    <a class="skip" href="#content">跳到正文</a>
    {
      surface === "reader" ? (
        <slot />
      ) : (
        <div class="browse">
          <slot />
        </div>
      )
    }
  </body>
</html>

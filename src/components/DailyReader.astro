---
import StoryPattern from "./StoryPattern.astro";
import IssueNav from "./IssueNav.astro";
import { readerUnits, storyGroup } from "../lib/reader-scope.mjs";
import { accentColor } from "../lib/stories.mjs";
import "../styles/reader.css";

type StorySection =
  | { kind: "quote"; text: string }
  | { kind: "p"; text: string }
  | { kind: "steps"; items: string[] }
  | { kind: "pull"; text: string }
  | { kind: "aside"; text: string };

interface StoryBody {
  pattern: "practice" | "benchmark" | "advice" | "framework" | "experiment" | "essay";
  sections: StorySection[];
}

interface Story {
  id: string;
  company: string;
  companyColor: string;
  column: string;
  title: string;
  originalTitle?: string;
  byline: string;
  body: StoryBody;
  sourceUrl: string;
  sourceLabel: string;
}

interface IssueLink {
  href: string;
  title: string;
}

interface Props {
  title: string;
  chipHref: string;
  chipLabel: string;
  stories: Story[];
  older?: IssueLink | null;
  newer?: IssueLink | null;
}

const { title, chipHref, chipLabel, stories, older = null, newer = null } = Astro.props;
const first = stories[0];
const hasIssues = Boolean(older || newer);
const units = readerUnits(stories);
const morningStories = stories.filter((story) => storyGroup(story.column) === "morning");
const pickStories = stories.filter((story) => storyGroup(story.column) === "picks");
const hasPicks = pickStories.length > 0;
---

<section class="reader" id="content" data-reader data-mode="desktop">
  <script is:inline>
    (function () {
      var fine = false;
      try {
        fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      } catch (error) {
        fine = true;
      }
      var mode = fine ? "desktop" : "magazine";
      var root = document.currentScript && document.currentScript.parentElement;
      if (!root || !root.hasAttribute("data-reader")) {
        document.querySelectorAll("[data-reader]").forEach(function (node) {
          node.setAttribute("data-mode", mode);
        });
        return;
      }
      root.setAttribute("data-mode", mode);
    })();
  </script>
  <div class="reader-tools">
    <a class="reader-chip" href={chipHref}>
      {chipLabel}
      <span class="visually-hidden">，回到首页</span>
    </a>
    <button
      type="button"
      class="toc-entry"
      aria-label="目录"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="toc-panel"
    >
      目录
    </button>
    <button
      type="button"
      class="comfort-entry"
      aria-label="版式"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="comfort-sheet"
    >
      Aa
    </button>
    <div class="comfort-sheet" id="comfort-sheet" role="dialog" aria-label="版式" hidden>
      <div class="comfort-options" role="radiogroup" aria-label="版式">
        <label class="comfort-option">
          <input type="radio" name="comfort" value="tight" />
          紧凑
        </label>
        <label class="comfort-option">
          <input type="radio" name="comfort" value="standard" checked />
          标准
        </label>
        <label class="comfort-option">
          <input type="radio" name="comfort" value="loose" />
          宽松
        </label>
      </div>
    </div>
  </div>
  <h1 class="visually-hidden">{title}</h1>
  <div class="reader-stage" role="feed" aria-label="AI Coding 日报">
    <div class="reader-live" aria-live="polite">
      {first ? `${first.company} · ${first.title}` : title}
    </div>
    <div class="reader-track">
      {
        units.map((unit, unitIndex) => {
          if (unit.kind === "break") {
            const following = pickStories[0];
            return (
              <section
                class:list={["section-break", "reader-unit", { "is-active": unitIndex === 0 }]}
                id="section-picks"
                data-kind="break"
                data-group="picks"
                data-title="选读"
                aria-label="选读"
              >
                <div class="section-break-main">
                  <p class="section-break-label">选读</p>
                </div>
                {following && <p class="story-hint">上滑 · {following.title}</p>}
              </section>
            );
          }
          const story = stories[unit.index];
          const next = stories[unit.index + 1];
          const nextUnit = units[unitIndex + 1];
          const accent = accentColor(story.companyColor);
          const last = unit.index === stories.length - 1;
          const swipeTitle = nextUnit?.kind === "break" ? "选读" : next?.title;
          const beforePicks = Boolean(next && storyGroup(next.column) === "picks");
          return (
            <article
              class:list={["story", "reader-unit", { "is-active": unitIndex === 0 }]}
              id={`story-${story.id}`}
              data-id={story.id}
              data-kind="story"
              data-group={unit.group}
              data-title={story.title}
              data-company={story.company}
              data-next-group={next ? storyGroup(next.column) : undefined}
              aria-labelledby={`title-${story.id}`}
              aria-posinset={unit.index + 1}
              aria-setsize={stories.length}
              style={`--company:${accent}`}
            >
              <div class="story-main">
                <header class="story-head">
                  <div class="story-kicker">
                    <span class="story-company">{story.company}</span>
                    <span class="story-dot" aria-hidden="true">·</span>
                    <span class="story-column">{story.column}</span>
                  </div>
                  <h2 id={`title-${story.id}`}>{story.title}</h2>
                  {story.originalTitle && <p class="story-original">{story.originalTitle}</p>}
                  <div class="story-byline">
                    <span>{story.byline}</span>
                    <span class="story-dot" aria-hidden="true">·</span>
                    <a class="story-source" href={story.sourceUrl} target="_blank" rel="noreferrer noopener">
                      {story.sourceLabel}
                    </a>
                  </div>
                </header>
                <div class="story-body">
                  <StoryPattern body={story.body} />
                </div>
                {next && <p class="story-next">下一篇 · {next.title}</p>}
              </div>
              {swipeTitle ? (
                <p class="story-hint">上滑 · {swipeTitle}</p>
              ) : last && hasIssues ? (
                <IssueNav class="story-issues" older={older} newer={newer} />
              ) : (
                <div class="story-tail" aria-hidden="true" />
              )}
              {hasIssues && beforePicks && (
                <IssueNav class="story-issues story-issues-morning" older={older} newer={newer} />
              )}
            </article>
          );
        })
      }
      {hasIssues && <IssueNav class="reader-end" older={older} newer={newer} />}
    </div>
  </div>
  <div class="toc-sheet" id="toc-sheet" hidden>
    <div class="toc-scrim" data-toc-scrim aria-hidden="true"></div>
    <div class="toc-panel" id="toc-panel" role="dialog" aria-modal="true" aria-label="目录" tabindex="-1">
      {
        hasPicks && (
          <div class="toc-scope" role="group" aria-label="阅读范围">
            <button type="button" data-scope-choice="all" aria-pressed="true">
              全部
            </button>
            <button type="button" data-scope-choice="morning" aria-pressed="false">
              只看 Morning
            </button>
          </div>
        )
      }
      {
        morningStories.length > 0 && (
          <div class="toc-group" data-group="morning">
            <h2>Morning</h2>
            <ol>
              {morningStories.map((story) => (
                <li>
                  <button type="button" class="toc-row" data-story={story.id}>
                    <span class="toc-company">{story.company}</span>
                    <span class="toc-title">{story.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        )
      }
      {
        hasPicks && (
          <div class="toc-group" data-group="picks">
            <h2>选读</h2>
            <ol>
              {pickStories.map((story) => (
                <li>
                  <button type="button" class="toc-row" data-story={story.id}>
                    <span class="toc-company">{story.company}</span>
                    <span class="toc-title">{story.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { COMFORT_KEY, normalizeComfort } from "../lib/reader-comfort.mjs";
  import {
    FINE_POINTER_QUERY,
    createSession,
    displayY,
    pointerDown,
    pointerMove,
    pointerUp,
    settleImmediately,
    tick,
  } from "../lib/reader-gesture.mjs";
  import { SCOPE_KEY, normalizeScope } from "../lib/reader-scope.mjs";
  import { stepSheetSpring } from "../lib/reader-sheet.mjs";

  function stageHeight(stage) {
    return stage.clientHeight || 760;
  }

  function isControl(target) {
    return target instanceof Element && Boolean(target.closest("a, button"));
  }

  function mount(root) {
    const stage = root.querySelector(".reader-stage");
    const track = root.querySelector(".reader-track");
    const live = root.querySelector(".reader-live");
    if (!stage || !track || root.querySelectorAll(".reader-unit").length === 0) return;

    const mq = window.matchMedia(FINE_POINTER_QUERY);
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let session = createSession(1);
    let raf = 0;

    function visibleUnits() {
      return [...root.querySelectorAll(".reader-unit")].filter((element) => !element.classList.contains("is-filtered"));
    }

    function restSession(index, count) {
      return { ...createSession(count), index };
    }

    function syncPositions(list) {
      const storyList = list.filter((element) => element.classList.contains("story"));
      storyList.forEach((element, index) => {
        element.setAttribute("aria-posinset", String(index + 1));
        element.setAttribute("aria-setsize", String(storyList.length));
      });
    }

    function syncScopeButtons(scope) {
      root.querySelectorAll("[data-scope-choice]").forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.setAttribute("aria-pressed", button.dataset.scopeChoice === scope ? "true" : "false");
      });
    }

    function setScope(scope, persist) {
      const previous = visibleUnits()[session.index];
      const next = normalizeScope(scope);
      document.documentElement.setAttribute("data-scope", next);
      if (persist) {
        try {
          localStorage.setItem(SCOPE_KEY, next);
        } catch (error) {
          /* storage can be blocked; the attribute still applies for this page */
        }
      }
      root.querySelectorAll(".reader-unit").forEach((element) => {
        const hide = next === "morning" && element.dataset.group === "picks";
        element.classList.toggle("is-filtered", hide);
        if (hide) element.setAttribute("hidden", "");
        else element.removeAttribute("hidden");
      });
      const list = visibleUnits();
      let index = previous ? list.indexOf(previous) : 0;
      if (index < 0) index = 0;
      stopLoop();
      session = restSession(index, list.length);
      syncPositions(list);
      syncScopeButtons(next);
      apply();
    }

    function stopLoop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function fadeIn() {
      track.style.transition = "none";
      track.style.opacity = "0";
      requestAnimationFrame(() => {
        track.style.transition = "opacity 180ms linear";
        track.style.opacity = "1";
      });
    }

    function apply() {
      const fine = mq.matches;
      root.dataset.mode = fine ? "desktop" : "magazine";
      document.documentElement.setAttribute("data-pointer", fine ? "fine" : "coarse");
      if (fine) stage.setAttribute("tabindex", "0");
      else stage.removeAttribute("tabindex");

      const list = visibleUnits();
      if (session.index > list.length - 1 || session.count !== list.length) {
        session = {
          ...session,
          count: list.length,
          index: Math.min(session.index, Math.max(0, list.length - 1)),
        };
      }
      root.querySelectorAll(".reader-unit").forEach((element) => {
        element.classList.remove("is-active");
      });
      const current = list[session.index];
      if (!current) return;
      current.classList.add("is-active");
      const company = current.dataset.company;
      const piece = current.dataset.title || "";
      const label = company ? `${company} · ${piece}` : piece;
      if (live && live.textContent !== label) live.textContent = label;
      const paging = !fine && session.pageMode && session.dragging;
      track.classList.toggle("is-paging", paging);
      if (fine) {
        track.style.transform = "";
        track.style.userSelect = "";
        return;
      }
      const y = displayY(session, stageHeight(stage));
      track.style.transform = `translateY(${y}px)`;
      track.style.userSelect = session.dragging ? "none" : "text";
      const hint = current.querySelector(".story-hint");
      if (hint instanceof HTMLElement) {
        const opacity = session.dragging ? Math.min(1, 0.45 + Math.abs(session.dragY) / 160) : 0.55;
        const lift = session.dragging && session.dragY < 0 ? Math.min(12, -session.dragY / 10) : 0;
        hint.style.opacity = String(opacity);
        hint.style.transform = lift ? `translateY(${-lift}px)` : "";
      }
    }

    function pump() {
      if (reduce.matches) {
        const previous = session.index;
        const paging = session.settling === "page";
        session = settleImmediately(session);
        const landed = visibleUnits()[session.index];
        if (session.index !== previous && landed) landed.scrollTop = 0;
        apply();
        if (paging) fadeIn();
        return;
      }
      track.style.transition = "";
      stopLoop();
      const step = () => {
        if (!session.settling) {
          raf = 0;
          return;
        }
        const previous = session.index;
        session = tick(session, stageHeight(stage));
        const landed = visibleUnits()[session.index];
        if (session.index !== previous && landed) landed.scrollTop = 0;
        apply();
        if (session.settling) raf = requestAnimationFrame(step);
        else raf = 0;
      };
      raf = requestAnimationFrame(step);
    }

    function scrollSnapshot() {
      const element = visibleUnits()[session.index];
      if (!element) return null;
      return {
        scrollTop: element.scrollTop,
        scrollHeight: element.scrollHeight,
        clientHeight: element.clientHeight,
      };
    }

    function onDown(event) {
      if (isControl(event.target)) {
        event.stopPropagation();
        return;
      }
      if (mq.matches || event.pointerType === "mouse") return;
      session = pointerDown(session, {
        pointerType: event.pointerType,
        clientY: event.clientY,
        time: performance.now(),
        onControl: false,
      });
    }

    function onMove(event) {
      if (mq.matches || event.pointerType === "mouse") return;
      const touchLike = event.pointerType === "touch" || event.pointerType === "pen";
      const next = pointerMove(session, {
        pointerType: event.pointerType,
        clientY: event.clientY,
        time: performance.now(),
        buttons: touchLike ? 1 : event.buttons,
        scroll: scrollSnapshot(),
        stageH: stageHeight(stage),
      });
      const started = !session.settling && next.settling;
      session = next;
      if (session.pageMode && session.dragging) {
        if (event.cancelable) event.preventDefault();
        if (!track.hasPointerCapture(event.pointerId)) {
          try {
            track.setPointerCapture(event.pointerId);
          } catch {
            /* capture can fail if the pointer already ended */
          }
        }
      }
      apply();
      if (started) pump();
    }

    function onUp(event) {
      if (mq.matches) return;
      if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
      const next = pointerUp(session, stageHeight(stage));
      const started = !session.settling && next.settling;
      session = next;
      apply();
      if (started) pump();
    }

    function scrollDesktop(element) {
      const margin = 56;
      const top = element.getBoundingClientRect().top - stage.getBoundingClientRect().top + stage.scrollTop - margin;
      stage.scrollTo({ top: Math.max(0, top), behavior: "auto" });
    }

    function goTo(element) {
      if (element.classList.contains("is-filtered")) setScope("all", true);
      const list = visibleUnits();
      const index = list.indexOf(element);
      if (index < 0) return;
      stopLoop();
      if (stage instanceof HTMLElement) stage.inert = false;
      session = restSession(index, list.length);
      apply();
      if (mq.matches) scrollDesktop(element);
      else element.scrollTop = 0;
    }

    function onKey(event) {
      if (!mq.matches) return;
      if (root.querySelector(".toc-sheet.is-open")) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.target instanceof Element && event.target.closest("a, button, input, textarea, select")) return;
      let delta = 0;
      if (event.key === "ArrowDown" || event.key === "j") delta = 80;
      else if (event.key === "ArrowUp" || event.key === "k") delta = -80;
      else if (event.key === "PageDown") delta = stage.clientHeight * 0.9;
      else if (event.key === "PageUp") delta = stage.clientHeight * -0.9;
      else if (event.key === " ") delta = stage.clientHeight * (event.shiftKey ? -0.9 : 0.9);
      else return;
      event.preventDefault();
      stage.scrollBy({ top: delta });
    }

    track.addEventListener("pointerdown", onDown);
    track.addEventListener("pointermove", onMove, { passive: false });
    track.addEventListener("pointerup", onUp);
    track.addEventListener("pointercancel", onUp);
    track.addEventListener(
      "touchmove",
      (event) => {
        if (mq.matches) return;
        if (session.pageMode && session.dragging && event.cancelable) event.preventDefault();
      },
      { passive: false },
    );
    window.addEventListener("keydown", onKey);

    function applyHash() {
      const hash = window.location.hash;
      if (!hash) return;
      const element = [...root.querySelectorAll(".reader-unit")].find((node) => `#${node.id}` === hash);
      if (!(element instanceof HTMLElement)) return;
      goTo(element);
    }

    function syncMode() {
      if (mq.matches) {
        stopLoop();
        session = {
          ...session,
          dragY: 0,
          dragging: false,
          settling: null,
          pressing: false,
          pageMode: false,
          armed: false,
          velocity: 0,
          settleVel: 0,
          pendingDelta: 0,
        };
      }
      apply();
    }

    setScope(normalizeScope(document.documentElement.getAttribute("data-scope")), false);
    syncMode();
    applyHash();
    root.addEventListener("reader-scope", (event) => {
      if (!(event instanceof CustomEvent)) return;
      setScope(String(event.detail), true);
    });
    root.addEventListener("reader-go", (event) => {
      if (!(event instanceof CustomEvent)) return;
      const element = root.querySelector(`#story-${String(event.detail)}`);
      if (element instanceof HTMLElement) goTo(element);
    });
    mq.addEventListener("change", syncMode);
    window.addEventListener("hashchange", applyHash);
    window.addEventListener("resize", () => {
      if (session.settling === "page") apply();
    });
  }

  function mountComfort(root) {
    const tools = root.querySelector(".reader-tools");
    const entry = root.querySelector(".comfort-entry");
    const sheet = root.querySelector(".comfort-sheet");
    if (!(tools instanceof HTMLElement) || !(entry instanceof HTMLButtonElement) || !(sheet instanceof HTMLElement)) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const radios = [...sheet.querySelectorAll('input[type="radio"]')];
    let open = false;
    let generation = 0;

    function syncRadios(tier) {
      for (const radio of radios) {
        if (radio instanceof HTMLInputElement) radio.checked = radio.value === tier;
      }
    }

    function applyTier(tier) {
      const next = normalizeComfort(tier);
      document.documentElement.setAttribute("data-comfort", next);
      try {
        localStorage.setItem(COMFORT_KEY, next);
      } catch (error) {
        /* storage can be blocked; the attribute still applies for this page */
      }
      syncRadios(next);
    }

    function openSheet() {
      if (open) return;
      const tocEntry = root.querySelector(".toc-entry");
      if (tocEntry instanceof HTMLButtonElement && tocEntry.getAttribute("aria-expanded") === "true") {
        tocEntry.click();
      }
      open = true;
      generation += 1;
      syncRadios(normalizeComfort(document.documentElement.getAttribute("data-comfort")));
      sheet.hidden = false;
      entry.setAttribute("aria-expanded", "true");
      const show = () => sheet.classList.add("is-open");
      if (reduce.matches) show();
      else requestAnimationFrame(show);
      const checked = radios.find((radio) => radio instanceof HTMLInputElement && radio.checked);
      if (checked instanceof HTMLElement) checked.focus({ preventScroll: true });
    }

    function closeSheet(restoreFocus) {
      if (!open) return;
      open = false;
      const token = ++generation;
      entry.setAttribute("aria-expanded", "false");
      let settled = false;
      const done = () => {
        if (settled || token !== generation) return;
        settled = true;
        sheet.hidden = true;
        sheet.classList.remove("is-open");
        if (restoreFocus) entry.focus({ preventScroll: true });
      };
      if (reduce.matches) {
        done();
        return;
      }
      sheet.classList.remove("is-open");
      const onEnd = (event) => {
        if (event.propertyName !== "opacity") return;
        sheet.removeEventListener("transitionend", onEnd);
        done();
      };
      sheet.addEventListener("transitionend", onEnd);
      window.setTimeout(() => {
        sheet.removeEventListener("transitionend", onEnd);
        done();
      }, 200);
    }

    syncRadios(normalizeComfort(document.documentElement.getAttribute("data-comfort")));

    entry.addEventListener("click", () => {
      if (open) closeSheet(false);
      else openSheet();
    });

    sheet.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.type !== "radio") return;
      applyTier(target.value);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !open) return;
      event.preventDefault();
      closeSheet(true);
    });

    document.addEventListener("pointerdown", (event) => {
      if (!open) return;
      const target = event.target;
      if (target instanceof Node && tools.contains(target)) return;
      closeSheet(true);
    });
  }

  function mountToc(root) {
    const entry = root.querySelector(".toc-entry");
    const sheet = root.querySelector(".toc-sheet");
    const panel = root.querySelector(".toc-panel");
    const stage = root.querySelector(".reader-stage");
    if (
      !(entry instanceof HTMLButtonElement) ||
      !(sheet instanceof HTMLElement) ||
      !(panel instanceof HTMLElement)
    ) {
      return;
    }

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let open = false;
    let restoreFocus = false;
    let target = 0;
    let spring = { value: 0, velocity: 0 };
    let sheetRaf = 0;
    let last = 0;

    function setInert(on) {
      if (stage instanceof HTMLElement) stage.inert = on;
      const tools = root.querySelector(".reader-tools");
      if (tools instanceof HTMLElement) tools.inert = on;
    }

    function paint(value) {
      sheet.style.setProperty("--sheet-p", String(value));
    }

    function finishClose() {
      if (open || target !== 0) return;
      sheet.hidden = true;
      sheet.classList.remove("is-open");
      setInert(false);
      if (restoreFocus) entry.focus({ preventScroll: true });
    }

    function step(now) {
      const dt = Math.min(0.032, (now - last) / 1000 || 0.016);
      last = now;
      spring = stepSheetSpring(spring, target, dt);
      paint(spring.value);
      if (!spring.settled) {
        sheetRaf = requestAnimationFrame(step);
        return;
      }
      sheetRaf = 0;
      if (target === 0) finishClose();
    }

    function startLoop() {
      if (sheetRaf) return;
      last = performance.now();
      sheetRaf = requestAnimationFrame(step);
    }

    function focusDialog() {
      const pressed = panel.querySelector('[data-scope-choice][aria-pressed="true"]');
      const row = panel.querySelector(".toc-row:not([hidden])");
      const node = pressed || row || panel;
      if (node instanceof HTMLElement) node.focus({ preventScroll: true });
    }

    function focusable() {
      return [...panel.querySelectorAll("button, a[href], input")].filter((node) => {
        if (!(node instanceof HTMLElement)) return false;
        if (node.closest("[hidden]")) return false;
        return node.getClientRects().length > 0;
      });
    }

    function openSheet() {
      if (open) return;
      const comfortEntry = root.querySelector(".comfort-entry");
      if (comfortEntry instanceof HTMLButtonElement && comfortEntry.getAttribute("aria-expanded") === "true") {
        comfortEntry.click();
      }
      open = true;
      restoreFocus = false;
      target = 1;
      entry.setAttribute("aria-expanded", "true");
      sheet.hidden = false;
      setInert(true);
      sheet.classList.add("is-open");
      if (reduce.matches) {
        if (sheetRaf) cancelAnimationFrame(sheetRaf);
        sheetRaf = 0;
        spring = { value: 0, velocity: 0 };
        paint(0);
        requestAnimationFrame(() => {
          spring = { value: 1, velocity: 0 };
          paint(1);
        });
      } else {
        startLoop();
      }
      focusDialog();
    }

    function closeSheet(restore) {
      if (!open) return;
      open = false;
      restoreFocus = restore;
      target = 0;
      entry.setAttribute("aria-expanded", "false");
      if (reduce.matches) {
        if (sheetRaf) cancelAnimationFrame(sheetRaf);
        sheetRaf = 0;
        spring = { value: 0, velocity: 0 };
        paint(0);
        const done = () => finishClose();
        const onEnd = (event) => {
          if (event.propertyName !== "opacity") return;
          sheet.removeEventListener("transitionend", onEnd);
          done();
        };
        sheet.addEventListener("transitionend", onEnd);
        window.setTimeout(() => {
          sheet.removeEventListener("transitionend", onEnd);
          done();
        }, 180);
        return;
      }
      startLoop();
    }

    entry.addEventListener("click", () => {
      if (open) closeSheet(false);
      else openSheet();
    });

    const scrim = sheet.querySelector("[data-toc-scrim]");
    if (scrim) scrim.addEventListener("click", () => closeSheet(true));

    panel.addEventListener("click", (event) => {
      const targetNode = event.target;
      if (!(targetNode instanceof Element)) return;
      const choice = targetNode.closest("[data-scope-choice]");
      if (choice instanceof HTMLButtonElement) {
        root.dispatchEvent(new CustomEvent("reader-scope", { detail: choice.dataset.scopeChoice }));
        return;
      }
      const row = targetNode.closest(".toc-row");
      if (!(row instanceof HTMLButtonElement)) return;
      root.dispatchEvent(new CustomEvent("reader-go", { detail: row.dataset.story }));
      closeSheet(true);
    });

    sheet.addEventListener(
      "wheel",
      (event) => {
        if (!open) return;
        if (event.target instanceof Node && panel.contains(event.target)) return;
        event.preventDefault();
      },
      { passive: false },
    );

    document.addEventListener("keydown", (event) => {
      if (!open) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeSheet(true);
        return;
      }
      if (event.key !== "Tab") return;
      const items = focusable();
      if (items.length === 0) {
        event.preventDefault();
        panel.focus();
        return;
      }
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !panel.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !panel.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    });
  }

  document.querySelectorAll("[data-reader]").forEach((node) => {
    if (node instanceof HTMLElement) {
      mount(node);
      mountComfort(node);
      mountToc(node);
    }
  });
</script>

---
type StorySection =
  | { kind: "quote"; text: string }
  | { kind: "p"; text: string }
  | { kind: "h"; text: string }
  | { kind: "steps"; items: string[] }
  | { kind: "pull"; text: string }
  | { kind: "aside"; text: string };

interface StoryBody {
  pattern: "practice" | "benchmark" | "advice" | "framework" | "experiment" | "essay";
  sections: StorySection[];
}

interface Props {
  body: StoryBody;
}

const { body } = Astro.props;
---

{
  body.sections.map((section) => {
    if (section.kind === "quote") {
      return <blockquote class="story-quote">{section.text}</blockquote>;
    }
    if (section.kind === "p") {
      return <p>{section.text}</p>;
    }
    if (section.kind === "h") {
      return <h3 class="story-h">{section.text}</h3>;
    }
    if (section.kind === "steps") {
      return (
        <ol class="story-steps">
          {section.items.map((item, index) => (
            <li>
              <span class="n" aria-hidden="true">
                {index + 1}
              </span>
              {item}
            </li>
          ))}
        </ol>
      );
    }
    if (section.kind === "pull") {
      return <blockquote class="story-pull">{section.text}</blockquote>;
    }
    if (section.kind === "aside") {
      return <aside class="story-aside">{section.text}</aside>;
    }
    return null;
  })
}

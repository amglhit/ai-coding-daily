---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import { decorateIssues, formatIsoDate, formatLongDate, metaDescription } from "../lib/digest.mjs";
import { readEntryMarkdown } from "../lib/entry.mjs";
import { sitePath } from "../lib/paths.mjs";
import { storyDescription } from "../lib/stories.mjs";

const { newestFirst } = decorateIssues(await getCollection("daily"));
const latest = newestFirst[0];
const past = newestFirst.slice(1);
const stories = latest?.data.stories ?? [];
const hasReader = stories.length > 0;
const markdown = latest && !hasReader ? readEntryMarkdown(latest) : "";
const description = hasReader
  ? storyDescription(stories)
  : latest
    ? metaDescription(markdown)
    : "AI Coding 日报，一份关于人工智能编程的每日杂志。";
const hook = description;
---

<Base title="AI Coding 日报" description={description}>
  <Masthead />
  <main id="content">
    {
      latest ? (
        <article class="hero">
          <p class="issue-meta">
            <time datetime={formatIsoDate(latest.data.date)}>{formatLongDate(latest.data.date)}</time>
          </p>
          <h1><a href={sitePath(`daily/${latest.id}/`)}>{latest.data.title}</a></h1>
          <p class="hook">{hook}</p>
          <a class="cta" href={sitePath(`daily/${latest.id}/`)}>开始阅读</a>
        </article>
      ) : (
        <p class="empty">还没有刊期。把 Markdown 放进 <code>src/content/daily/</code> 即可。</p>
      )
    }

    <section class="past" aria-labelledby="past-heading">
      <div class="past-head">
        <h2 id="past-heading">过往刊期</h2>
        <a href={sitePath("archive/")}>全部归档</a>
      </div>
      {
        past.length === 0 ? (
          <p class="empty">创刊号，尚无过往刊期。</p>
        ) : (
          <ol class="archive-list">
            {past.map((issue) => (
              <li>
                <a class="is-inline" href={sitePath(`daily/${issue.id}/`)}>
                  <time datetime={formatIsoDate(issue.data.date)}>{formatIsoDate(issue.data.date)}</time>
                  <span aria-hidden="true">·</span>
                  <span class="archive-title">{issue.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </main>
  <Footer />
</Base>

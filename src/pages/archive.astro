---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import { decorateIssues, formatIsoDate, formatLongDate } from "../lib/digest.mjs";
import { sitePath } from "../lib/paths.mjs";

const { newestFirst } = decorateIssues(await getCollection("daily"));
const filters = ["全部", "行业动向", "工程化实践", "社区热点", "选读"];
---

<Base title="归档 · AI Coding 日报" description="AI Coding 日报全部刊期，按日期排列。">
  <Masthead />
  <main id="content" class="archive">
    <header class="archive-head">
      <h1>全部刊期</h1>
      <p>按日期排列。点栏目可以只看包含该栏的期数。</p>
    </header>

    <div class="filters" role="group" aria-label="按栏目筛选">
      {
        filters.map((filter, index) => (
          <button type="button" data-filter={filter === "全部" ? "all" : filter} aria-pressed={index === 0 ? "true" : "false"}>
            {filter}
          </button>
        ))
      }
    </div>

    {
      newestFirst.length === 0 ? (
        <p class="empty">还没有刊期。</p>
      ) : (
        <ol class="archive-list">
          {newestFirst.map((issue) => (
            <li data-columns={issue.data.columns.join(",")}>
              <a href={sitePath(`daily/${issue.id}/`)}>
                <time datetime={formatIsoDate(issue.data.date)}>{formatLongDate(issue.data.date)}</time>
                <span>
                  <span class="archive-title">{issue.data.title}</span>
                  {issue.data.must_read.length > 0 && (
                    <span class="archive-must">必读 {issue.data.must_read.join(" · ")}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
    <p id="archive-empty" class="empty" hidden>没有这一栏的刊期。</p>
  </main>
  <Footer />
</Base>

<script>
  const buttons = document.querySelectorAll("[data-filter]");
  const items = document.querySelectorAll("[data-columns]");
  const empty = document.querySelector("#archive-empty");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter || "all";
      buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      items.forEach((item) => {
        const columns = (item.dataset.columns || "").split(",").filter(Boolean);
        const hide = filter !== "all" && !columns.includes(filter);
        item.toggleAttribute("hidden", hide);
      });
      if (empty) {
        const anyVisible = [...items].some((item) => !item.hasAttribute("hidden"));
        empty.toggleAttribute("hidden", anyVisible);
      }
    });
  });
</script>
